{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "movedetail.schema.json",
  "title": "move detail Schema",

  "$defs": {
    "Detail": {
      "type": "object",
      "properties": {
        "Index": { "type": "integer", "default": -1 },
        "Value": { "type": "integer", "default": -1 },
        "Store": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "integer"
            }
          }
        },
        "Share": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "integer"
            }
          }
        },
        "RoundUp": { "type": "boolean" }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["Index", "Value"] },
        { "required": ["Store"] },
        { "required": ["Index", "Share"] },
        { "required": ["RoundUp"] }
      ]
    }
  }
}
