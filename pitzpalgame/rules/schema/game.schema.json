{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.schema.json",
  "title": "Game Schema",

  "$defs": {
    "Game": {
      "type": "object",
      "required": ["GameID", "Name", "Level", "Players"],
      "properties": {
        "GameID": {
          "type": "string",
          "format": "uuid"
        },
        "Name": {
          "$ref": "name.schema.json#/$defs/Name"
        },
        "Level": {
          "$ref": "level.schema.json#/$defs/Level"
        },
        "Config": {
          "$ref": "config.schema.json#/$defs/Config"
        },
        "Board": {
          "$ref": "board.schema.json#/$defs/Board"
        },
        "Players": {
          "type": "array",
          "items": {
            "type": "string",
            "minimum": 0
          }
        },
        "CreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "Status": {
          "type": "string",
          "enum": ["toss", "active", "paused", "finished"]
        },
        "Toss": {
          "type": "array",
          "items": {
            "$ref": "toss.schema.json#/$defs/Toss"
          }
        },
        "Moves": {
          "type": "array",
          "items": {
            "$ref": "move.schema.json#/$defs/Move"
          }
        },
        "MoveReq": {
          "$ref": "move.schema.json#/$defs/Move"
        }
      },
      "additionalProperties": false
    }
  }
}
