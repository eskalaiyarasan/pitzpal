{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board.schema.json",
  "title": "Board Schema",

  "$defs": {
    "Board": {
      "type": "object",
      "required": ["Pits", "Turn", "Store"],
      "properties": {
        "Pits": {
          "type": "array",
          "items": {
            "$ref": "pit.schema.json#/$defs/Pit"
          }
        },
        "TotalSeeds": { "type": "integer", "minimum": 0 },
        "Turn": { "type": "integer", "default": 0 },
        "Store": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^[0-9]+$": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
