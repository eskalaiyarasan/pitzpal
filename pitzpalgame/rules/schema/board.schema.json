{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitzpalgame/rules/schema/board.schema.json",
  "title": "Board Schema",

  "$defs": {
    "Board": {
      "type": "object",
      "required": ["Pits"],
      "properties": {
        "Pits": {
          "type": "array",
          "items": {
		"$ref": "pitzpalgame/rules/schema/pit.schema.json#/$defs/Pit"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
