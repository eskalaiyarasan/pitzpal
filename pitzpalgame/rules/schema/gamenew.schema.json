{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitzpalgame/rules/schema/gamenew.schema.json",
  "title": "Game new Schema",

  "$defs": {
    "NewGame": {
      "type": "object",
      "required": ["Name", "Level", "Players"],
      "properties": {
        "Name": {
          "$ref": "pitzpalgame/rules/schema/name.schema.json#/$defs/Name"
        },
        "Level": {
          "$ref": "pitzpalgame/rules/schema/level.schema.json#/$defs/Level"
        },
        "Players": {
          "type": "array",
          "items": {
            "type": "string",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    }
  }
}
