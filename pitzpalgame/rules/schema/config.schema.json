{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Board config Schema",

  "$defs": {
    "Config": {
      "type": "object",
      "required": [
        "PitsPerSide",
        "Nside",
        "Nseeds",
        "Algorithm",
        "Early",
        "Kingzpits",
        "Plus",
        "Relay"
      ],
      "properties": {
        "PitsPerSide": {
          "type": "integer"
        },
        "Nside": {
          "type": "integer"
        },
        "Nseeds": {
          "type": "integer"
        },
        "Algorithm": {
          "$ref": "algorithm.schema.json#/$defs/Algorithm"
        },
        "Early": {
          "$ref": "early.schema.json#/$defs/Early"
        },
        "Kingzpits": {
          "$ref": "kingzpits.schema.json#/$defs/Kingzpits"
        },
        "Plus": {
          "$ref": "plus.schema.json#/$defs/Plus"
        },
        "Relay": {
          "$ref": "relay.schema.json#/$defs/Relay"
        }
      },
      "additionalProperties": false
    }
  }
}
