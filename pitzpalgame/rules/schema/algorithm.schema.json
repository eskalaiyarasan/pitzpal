{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "algorithm.schema.json",
  "title": "Algorithm Schema",

  "$defs": {
    "Algorithm": {
      "type": "object",
      "required": ["Value"],
      "properties": {
        "Type": {
          "type": "string",
          "const": "enum"
        },

        "SubType": {
          "type": "array",
          "const": ["classic", "snake", "spiral", "dark"]
        },
        "Value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
