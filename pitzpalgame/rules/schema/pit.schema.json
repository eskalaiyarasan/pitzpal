{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pit.schema.json",
  "title": "Board pit Schema",

  "$defs": {
    "Pit": {
      "type": "object",
      "required": ["Index", "Active", "Value", "Public"],
      "properties": {
        "Index": {
          "type": "integer"
        },
        "Active": {
          "type": "boolean",
          "default": false
        },
        "Value": {
          "type": "integer"
        },
        "Side": {
          "type": "integer"
        },
        "Public": {
          "type": "boolean",
          "default": false
        },
        "Share": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^[0-9]+$": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
